# RAG Production System - Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API (unused: generation and judging run on Groq)
# Get your free API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Data directories (optional, uses defaults if not set)
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
VECTORDB_DIR=data/vectordb

# Groq API (generation + RAGAS judge)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Model settings (optional)
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=openai/gpt-oss-20b
# Dedicated judge for RAGAS. Larger than the generator; JSON mode keeps reasoning from starving verdicts.
LLM_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Logging
LOG_LEVEL=INFO
